{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "allowJs": true, "checkJs": false, "noEmit": true, "skipLibCheck": true,
    "resolveJsonModule": true, "isolatedModules": true, "types": ["vite/client"],
    "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.js"],
  "exclude": ["src/**/*.test.js", "src/**/*.spec.js", "node_modules", "dist"]
}
