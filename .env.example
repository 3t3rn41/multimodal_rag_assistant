# 应用与认证：本地 FastAPI / Vite 地址，前端地址须包含在 CORS 列表中。
APP_TITLE=Multimodal RAG Assistant
APP_STAGE=pdf-rag
APP_ENV=development
APP_BACKEND_URL=http://127.0.0.1:8001
PUBLIC_BASE_URL=http://127.0.0.1:5174
APP_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
AUTH_TOKEN_MINUTES=30
# 替换为随机部署密钥；生产环境要求至少 32 字符、HTTPS 和安全 Cookie。
SECRET_KEY=replace_me

# MySQL：本地 Docker 映射端口为 3308，容器内连接由 Compose 覆盖。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=mmrag
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=multimodal_rag_assistant
MYSQL_ROOT_PASSWORD=replace_me

# Redis / Celery：应用、任务队列和任务结果分别使用 DB 0、1、2。
REDIS_HOST=127.0.0.1
REDIS_PORT=6378
REDIS_DB=0
CELERY_BROKER_URL=redis://127.0.0.1:6378/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6378/2
CELERY_QUEUE_PREFIX=mmrag

# Qdrant：服务端地址和向量集合须与入库、检索配置一致。
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
RAG_QDRANT_URL=http://127.0.0.1:6333
# 仅 Qdrant Cloud 或启用认证的自托管服务需要填写。
RAG_QDRANT_API_KEY=
# 可选本地持久化模式，设置后优先于 URL；网页 API/Worker 开发保持为空。
RAG_QDRANT_PATH=
RAG_QDRANT_COLLECTION=jina_v5_omni_small_1024
RAG_QDRANT_VECTOR_NAME=dense

# MinIO：内部访问与原文件预签名链接的对外地址。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace_me
MINIO_SECRET_KEY=replace_me
MINIO_BUCKET=raw-files

# SMTP：注册验证码和密码重置需要真实发信配置；此处使用 SSL / 465。
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=sender@example.com
SMTP_PASSWORD=replace_me
SMTP_FROM=sender@example.com
SMTP_SECURITY=ssl

# Jina Embedding / Rerank：网页入库与问答需填写有效 API Key。
JINA_API_KEY=fill_me

RAG_EMBEDDING_API_URL=https://api.jina.ai/v1/embeddings
# 可选独立密钥；留空时使用 JINA_API_KEY。
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=jina-embeddings-v5-omni-small
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_PASSAGE_TASK=retrieval.passage
RAG_EMBEDDING_QUERY_TASK=retrieval.query
RAG_EMBEDDING_TIMEOUT_SECONDS=60
RAG_EMBEDDING_MAX_RETRIES=3
RAG_EMBEDDING_RETRY_BACKOFF_SECONDS=0.5

# 当前网页问答要求启用 Jina 精排。
RAG_RERANK_ENABLED=true
RAG_RERANK_API_URL=https://api.jina.ai/v1/rerank
# 可选独立密钥；留空时使用 JINA_API_KEY。
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=jina-reranker-v3
RAG_RERANK_TIMEOUT_SECONDS=60
RAG_RERANK_MAX_RETRIES=3
RAG_RERANK_RETRY_BACKOFF_SECONDS=0.5

# 检索参数：两路召回通过加权 RRF 融合，最终上下文数量不超过候选数量。
RAG_RETRIEVAL_K=50
RAG_ANSWER_K=8
RAG_RRF_RANK_CONSTANT=60
RAG_DENSE_WEIGHT=1.0
RAG_LEXICAL_WEIGHT=1.0

# 问答模型：OpenAI-compatible 接口，使用前填写对应供应商的真实密钥。
RAG_LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
RAG_LLM_MODEL=qwen3.8-flash
RAG_LLM_API_KEY=fill_me
# 仅本地模型测试时启用，生产环境保持 false。
MODEL_ALLOW_LOCALHOST=false

# 可选媒体 API：转写和图片描述分别填写对应服务的密钥。
RAG_TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
RAG_TRANSCRIPTION_API_KEY=fill_me
RAG_TRANSCRIPTION_MODEL=whisper-1
RAG_VISION_API_URL=https://api.openai.com/v1/chat/completions
RAG_VISION_API_KEY=fill_me
RAG_VISION_MODEL=gpt-4o-mini
RAG_MEDIA_API_TIMEOUT_SECONDS=60
RAG_MEDIA_MAX_RETRIES=3
RAG_MEDIA_RETRY_BACKOFF_SECONDS=0.5

# 可选：将 minio:// 路径转换为媒体 API 可访问的 URL。
# 私有桶应由应用回调生成短时预签名链接，不应改为公开桶。
RAG_MEDIA_PUBLIC_BASE_URL=

# 填写 JINA_API_KEY 后可手动运行 python -m scripts.jina_smoke_test。
