# Jina multimodal embedding and reranking (fill locally; never commit keys)
JINA_API_KEY=fill_me

RAG_EMBEDDING_API_URL=https://api.jina.ai/v1/embeddings
# Optional provider-specific override; otherwise JINA_API_KEY is used.
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=jina-embeddings-v5-omni-small
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_PASSAGE_TASK=retrieval.passage
RAG_EMBEDDING_QUERY_TASK=retrieval.query
RAG_EMBEDDING_TIMEOUT_SECONDS=60
RAG_EMBEDDING_MAX_RETRIES=3
RAG_EMBEDDING_RETRY_BACKOFF_SECONDS=0.5

RAG_RERANK_API_URL=https://api.jina.ai/v1/rerank
# Optional provider-specific override; otherwise JINA_API_KEY is used.
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=jina-reranker-v3
RAG_RERANK_TIMEOUT_SECONDS=60
RAG_RERANK_MAX_RETRIES=3
RAG_RERANK_RETRY_BACKOFF_SECONDS=0.5

# Optional transcription and vision APIs used by media ingestion
RAG_TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
RAG_TRANSCRIPTION_API_KEY=fill_me
RAG_TRANSCRIPTION_MODEL=whisper-1
RAG_VISION_API_URL=https://api.openai.com/v1/chat/completions
RAG_VISION_API_KEY=fill_me
RAG_VISION_MODEL=gpt-4o-mini
RAG_MEDIA_API_TIMEOUT_SECONDS=60
RAG_MEDIA_MAX_RETRIES=3
RAG_MEDIA_RETRY_BACKOFF_SECONDS=0.5

# Qdrant batch indexing
RAG_QDRANT_URL=http://localhost:6333
# Only needed for Qdrant Cloud or a secured self-hosted instance.
RAG_QDRANT_API_KEY=
# Optional embedded persistent mode; if set, it takes precedence over URL.
RAG_QDRANT_PATH=
RAG_QDRANT_COLLECTION=jina_v5_omni_small_1024
RAG_QDRANT_VECTOR_NAME=dense

# Optional base URL used to turn minio:// paths into API-readable URLs.
# For private buckets, replace this with an application callback that creates
# short-lived presigned URLs instead of exposing a public bucket.
RAG_MEDIA_PUBLIC_BASE_URL=

# Run `python -m scripts.jina_smoke_test` after setting JINA_API_KEY.
